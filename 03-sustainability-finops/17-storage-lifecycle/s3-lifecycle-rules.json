{
	"Rules": [
		{
			"ID": "gestionale-archivio-main-lifecycle",
			"Status": "Enabled",
			"Filter": {
				"Prefix": "archivio/"
			},
			"Transitions": [
				{
					"Days": 30,
					"StorageClass": "STANDARD_IA"
				},
				{
					"Days": 90,
					"StorageClass": "GLACIER"
				},
				{
					"Days": 365,
					"StorageClass": "DEEP_ARCHIVE"
				}
			],
			"NoncurrentVersionTransitions": [
				{
					"NoncurrentDays": 30,
					"StorageClass": "STANDARD_IA"
				},
				{
					"NoncurrentDays": 90,
					"StorageClass": "GLACIER"
				}
			],
			"NoncurrentVersionExpiration": {
				"NoncurrentDays": 180
			},
			"Expiration": {
				"Days": 2555
			},
			"AbortIncompleteMultipartUpload": {
				"DaysAfterInitiation": 7
			}
		}
	]
}
